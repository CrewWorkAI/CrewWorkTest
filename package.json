{
  "name": "haiku-battle-league",
  "version": "0.1.0",
  "description": "MVP backend for Haiku Battle League – head‑to‑head haiku battles.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "worker": "node dist/workers/scoreAggregationWorker.js",
    "worker-dev": "ts-node-dev --respawn src/workers/scoreAggregationWorker.ts",
    "test": "node test/integration.test.js",
    "loadtest": "artillery run loadtests/artillery.yml"
  },
  "keywords": [
    "haiku",
    "battle",
    "league",
    "express"
  ],
  "author": "CrewWorkAI",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "bullmq": "^4.10.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "pg": "^8.11.0",
    "uuid": "^9.0.0",
    "ioredis": "^5.3.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^9.0.2",
    "nodemon": "^3.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "artillery": "^2.0.27"
  }
}
