# Multi‑stage build for frontend only
FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --silent
COPY frontend ./
RUN npm run build

FROM node:20-alpine
WORKDIR /app
# Copy build output from earlier stage
COPY --from=build /app .
EXPOSE 3000
USER node
CMD ["npm", "run", "start"]
